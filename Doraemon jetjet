local PlatformPart = nil
local AutoTPActive = false

local function createSkyPlatform(hrp)
    if PlatformPart and PlatformPart.Parent then
        PlatformPart:Destroy()
    end

    local targetCFrame = hrp.CFrame + Vector3.new(0, 3571, 0)
    
    PlatformPart = Instance.new("Part")
    PlatformPart.Name = "SkyPlatform_Doraemon"
    PlatformPart.Size = Vector3.new(30, 1, 30)
    PlatformPart.CFrame = targetCFrame - Vector3.new(0, 3.5, 0)
    PlatformPart.Anchored = true
    PlatformPart.CanCollide = true
    PlatformPart.Material = Enum.Material.Plastic
    PlatformPart.TopSurface = Enum.SurfaceType.Studs
    PlatformPart.Color = Color3.fromRGB(50, 200, 50)
    PlatformPart.Transparency = 0
    PlatformPart.Parent = workspace

    return targetCFrame
end

task.spawn(function()
    while task.wait(0.1) do
        local player = game.Players.LocalPlayer
        local curChar = player.Character
        local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
        local humanoid = curChar and curChar:FindFirstChildOfClass("Humanoid")
        
        if not curHrp or not humanoid or humanoid.Health <= 0 then continue end

        if AutoTPActive then
            if not PlatformPart or not PlatformPart.Parent then
                local safeCFrame = createSkyPlatform(curHrp)
                curHrp.CFrame = safeCFrame
            else
                local distance = (Vector3.new(curHrp.Position.X, 0, curHrp.Position.Z) - Vector3.new(PlatformPart.Position.X, 0, PlatformPart.Position.Z)).Magnitude
                local heightDiff = math.abs(curHrp.Position.Y - PlatformPart.Position.Y)

                if distance > 18 or heightDiff > 8 then
                    curHrp.CFrame = PlatformPart.CFrame + Vector3.new(0, 3.5, 0)
                    task.wait(0.5)
                end
            end
        end
    end
end)

