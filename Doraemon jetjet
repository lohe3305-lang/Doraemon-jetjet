local ESPEnabled = false

local function applyESP(vPlayer)
    if vPlayer == game.Players.LocalPlayer then return end

    local function addHighlight(character)
        if not character then return end
        if not character:FindFirstChild("ESPHighlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.Adornee = character
            highlight.FillColor = Color3.fromRGB(255, 0, 0)
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.OutlineTransparency = 0
            highlight.Enabled = ESPEnabled
            highlight.Parent = character
        end
    end

    if vPlayer.Character then addHighlight(vPlayer.Character) end
    vPlayer.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.5)
        addHighlight(char)
    end)
end

for _, player in pairs(game.Players:GetPlayers()) do applyESP(player) end
game.Players.PlayerAdded:Connect(applyESP)

