-- 2. TAB PLAYED: JUMP & SPEED
---------------------------------------------------------
local CustomJump = 50
local CustomSpeed = 16
local EnableJump = false
local EnableSpeed = false

local function updateJump(value)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid.UseJumpPower then
            humanoid.JumpPower = value
        else
            humanoid.JumpHeight = (value / 50) * 7.2
        end
    end
end

local function updateSpeed(value)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        humanoid.WalkSpeed = value
    end
end

game.Players.LocalPlayer.CharacterAdded:Connect(function(character)
    character:WaitForChild("Humanoid")
    task.wait(0.5)
    if EnableJump then updateJump(CustomJump) end
    if EnableSpeed then updateSpeed(CustomSpeed) end
end)

